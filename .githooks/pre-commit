#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$script_dir/.." && pwd)

python3 "$root/scripts/check-language-contract.py"
# The documentation contract used to run only in CI, so a red result did not
# stop anything: five commits reached published `main` while it was failing on
# ten committed files. A contract nobody can be stopped by is a contract that
# drifts, and the records it governs — evidence, plans, inventories — are the
# ones a later reader has to trust.
sh "$root/scripts/check-documentation-contract.sh" --quiet
exec python3 "$root/scripts/check-staged-units.py"
