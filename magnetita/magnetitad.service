# magnetitad, Magnetita's phone link, as a systemd *user* service: it keeps
# the suite's own QUIC wire open on UDP 1760 for the phone's application,
# serves org.celestina.Devices1 and org.celestina.Mirror1, and mounts the
# phone's shared folder under $XDG_RUNTIME_DIR/magnetita/.
#
# Installed by scripts/deploy-production.sh (never enabled by it); ExecStart
# is rewritten there to the deployed binary. Watch it with:
#   journalctl --user -u magnetitad -f

[Unit]
Description=Magnetita, the Celestina phone link
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/magnetitad
# SIGTERM makes the daemon close its sessions and unmount the phone before it
# exits; this only catches a daemon that was killed instead.
ExecStopPost=-/bin/sh -c 'for m in %t/magnetita/*/; do [ -d "$$m" ] && /usr/bin/fusermount3 -uz "$$m" 2>/dev/null; done; true'
Restart=on-failure
RestartSec=5
SyslogIdentifier=magnetitad

[Install]
WantedBy=default.target
