<?xml version="1.0" encoding="utf-8"?>
<!-- The phone's identity (its private key and certificate) and the pinned
     desktops live under files/magnetita. They belong to this install on this
     phone: a cloud restore or a device-to-device transfer would clone the
     identity onto another phone, so both exclude them. The manifest's
     allowBackup="false" does not stop a device-to-device transfer on its own. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="magnetita" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="magnetita" />
    </device-transfer>
</data-extraction-rules>
